# Langfuse observability (optional)
# Leave blank to disable
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://langfuse-web:3000"
LANGFUSE_FLUSH_AT=1

# vLLM (Linux standalone)
# Set INFERENCE_MODE=vllm when using the standalone vLLM compose override.
INFERENCE_MODE=dmr
VLLM_LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_LLM_QUANTIZATION=awq
